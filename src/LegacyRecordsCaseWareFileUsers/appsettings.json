{
  "ActiveDirectory": {
    "CaseWareSupportTeamGroupName": "[fill-me-in]",
    "DomainName": "[fill-me-in]"
  },
  "ApplicationLogging": {
    "ApplicationInsights": {
      "ConnectionString": ""
    },
    "ConsoleOutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {PhaseIndent}{Message}{NewLine}{Exception}",
    "DebugOutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{SourceContext}] {PhaseIndent}{Message}{NewLine}{Exception}",
    "File": {
      "OutputTemplate": "", // this setting defaults to ApplicationLogging:ConsoleOutputTemplate when not provided
      "Path": "", // this setting defaults to Output:Directory + "FileUsers-{RunID}.log" when not provided
      "RetainedFileCountLimit": 31,
      "RollingInterval": "Day"
    },
    "LogLevel": {
      "ApplicationInsights": "Warning",
      "Console": "Information",
      "Debug": "Warning",
      "Default": "Information",
      "File": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "CaseWare": {
    "LoginUserId": "[fill-me-in]",
    "LoginUserPassword": "[fill-me-in]",
    "RetryRetrievingUsersMaximumAttempts": 3
  },
  "ConnectionStrings": {
    "CaseWareFileManagement": "[fill-me-in]"
  },
  "Input": {
    "FilePath": "",
    "Files": []
  },
  "Output": {
    "Directory": "",
    "FilePath": "",
    "ShareSegmentIndex": 3 // depth of the share prefix in the UNC path; Share column holds the first N segments (e.g. \\server\volume\share) and File column holds everything below, so Share + \ + File reconstructs the full path
  },
  "Processing": {
    "MaxCopyDegreeOfParallelism": 0,
    "MaxDegreeOfParallelism": 0,
    "RetryErroredFilesOnResume": false // when true, --resume reprocesses files whose prior journal entry has errors; when false (default), trust the journal
  },
  "Workspace": {
    "RootPath": ""
  }
}
